{
  "name": "unpacked",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Explore your Spotify, Instagram and YouTube data exports. Runs entirely in your browser; nothing is uploaded.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@zip.js/zip.js": "^2.25.0",
    "comlink": "^4.4.2",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atuuuuuuu/unpacked.git"
  },
  "keywords": [
    "privacy",
    "local-first",
    "gdpr",
    "data-export",
    "data-visualization",
    "spotify",
    "instagram",
    "youtube",
    "pwa"
  ]
}
